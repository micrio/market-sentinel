#!/usr/bin/env bash
# Runs the Rails server, the Vite dev server and the Solid Queue worker together.
# bin/jobs defaults to Solid Queue's async (no-fork) mode to avoid the sqlite3
# fork-safety warning.
set -e

trap 'kill 0' EXIT

bin/vite dev &
bin/rails server -p "${PORT:-3000}" &
bin/jobs &

wait
