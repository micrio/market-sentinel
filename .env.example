# Shared by Rails (dotenv-rails) and Vite.

RAILS_MAX_THREADS=5

# --- AI -------------------------------------------------------------------
# DeepSeek powers sentiment scoring and the horizon projections (RubyLLM).
DEEPSEEK_API_KEY=
# Options: deepseek-chat (default), deepseek-reasoner.
DEEPSEEK_MODEL=deepseek-chat

# --- Quotes ---------------------------------------------------------------
# Finnhub is the fallback quote provider when Yahoo fails. Free key at finnhub.io.
FINNHUB_API_KEY=

# --- App ------------------------------------------------------------------
BASE_URL=http://localhost:3000
