# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# macOS
.DS_Store
**/.DS_Store

/.bundle

# Environment files (keep the template).
/.env*
!/.env*.erb
!/.env.example

# Vite Ruby
/public/vite*
node_modules
*.local

# Logs / temp / pid
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# SQLite databases
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

/config/master.key
